APP_NAME=Vendro
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vendro
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

QUEUE_DRIVER=redis
DEFAULT_PROVIDER=sandbox
PAYMENT_GATEWAY=wallet

MAIL_DRIVER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@vendro.local
MAIL_FROM_NAME=Vendro

CACHE_DRIVER=redis
CACHE_PREFIX=vendro_cache_

STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=

JWT_SECRET=replace-with-strong-secret-min-16-chars
JWT_TTL_MINUTES=60
REFRESH_TTL_DAYS=30
RATE_LIMIT_PER_MINUTE=60
API_SIGNATURE_REQUIRED=true
IP_WHITELIST_ENABLED=false

WEBHOOK_SIGNATURE_HEADER=X-Vendro-Signature
WEBHOOK_TIMESTAMP_HEADER=X-Vendro-Timestamp
WEBHOOK_MAX_SKEW_SECONDS=300
WEBHOOK_RETRY_ATTEMPTS=10
